# AGP Environment
#
# Copy this to .env and fill in your values.
# .env is gitignored; never commit real credentials.

# API keys required for runtime
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Remote CP, for runtime-remote / runtime-wezterm
AGP_REMOTE_SERVER_URL=http://your-server.example.com:7860

# Runtime identity
AGP_RUNTIME_ID=rtm_mac
AGP_RUNTIME_AGENT_ID=agt_local

# Model selection
AGP_CODEX_MODEL=openai/gpt-5.3-codex

# Local CP, for make serve / make local-serve
# AGP_HOST=0.0.0.0
# AGP_PORT=7860
# AGP_DATABASE_URL=postgresql+psycopg://agp:agp@localhost:5432/agp
# AGP_QUEUE_BACKEND=redis
# AGP_REDIS_URL=redis://localhost:6379/0

# smallops Docker Claude Code tests via OpenRouter
#
# For the Docker suite, prefer a dedicated file:
#   cp scripts/docker/smallops-openrouter.env.example .env.openrouter
#   make test-docker
#
# Keep ANTHROPIC_API_KEY empty in this mode; Claude Code authenticates via
# ANTHROPIC_AUTH_TOKEN against the OpenRouter-compatible Anthropic endpoint.
ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_API_KEY=
API_TIMEOUT_MS=3000000
ANTHROPIC_DEFAULT_OPUS_MODEL=x-ai/grok-4.20
ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=minimax/minimax-m2.7
