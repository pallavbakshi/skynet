# Copy to .env or pass with:
#   SMALLOPS_DOCKER_ENV_FILE=scripts/docker/smallops-openrouter.env make test-docker
#
# Do not commit real tokens.
ANTHROPIC_AUTH_TOKEN=sk-or-v1-...
ANTHROPIC_BASE_URL=https://openrouter.ai/api
API_TIMEOUT_MS=3000000

# Claude Code should use the OpenRouter auth token above.
ANTHROPIC_API_KEY=

ANTHROPIC_DEFAULT_OPUS_MODEL=x-ai/grok-4.20
ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=minimax/minimax-m2.7
